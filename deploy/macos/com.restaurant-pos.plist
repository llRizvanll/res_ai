<?xml version="1.0" encoding="UTF-8"?>
<!-- Starts the POS when this Mac user logs in and keeps it running.
     1. Replace /Users/YOU/restaurant-pos with the folder you installed it in (3 places), and the node path if different
        (find it with: which node).
     2. cp deploy/macos/com.restaurant-pos.plist ~/Library/LaunchAgents/
     3. launchctl load ~/Library/LaunchAgents/com.restaurant-pos.plist
     Also set the Mac to never sleep (System Settings → Energy) and to log in automatically. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.restaurant-pos</string>
  <key>WorkingDirectory</key><string>/Users/YOU/restaurant-pos</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/node</string>
    <string>--no-warnings</string>
    <string>--env-file-if-exists=.env</string>
    <string>dist/server/supervisor.js</string>
  </array>
  <key>EnvironmentVariables</key><dict><key>TZ</key><string>Asia/Kolkata</string></dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/Users/YOU/restaurant-pos/data/logs/launchd.log</string>
  <key>StandardErrorPath</key><string>/Users/YOU/restaurant-pos/data/logs/launchd.log</string>
</dict>
</plist>
