# Copy to .env and adjust. Every setting is optional; defaults are shown.

# Port the app listens on
PORT=3000
# Time zone used for "today", daily reports and the closing-time backup
TZ=Asia/Kolkata
# Where databases, backups and logs are kept (Docker uses /data)
# DATA_DIR=./data

# Set to 1 when the app sits behind Cloudflare Tunnel, Caddy or Nginx, so real visitor IPs are logged
TRUST_PROXY=0

# Backups: how often (minutes) when data changed, and an optional second folder (USB / Google Drive folder)
BACKUP_INTERVAL_MIN=30
# BACKUP_MIRROR_DIR=/path/to/second/backup/folder

# Sign-in protection
LOGIN_LOCK_AFTER=5
LOGIN_LOCK_MINUTES=5
SESSION_DAYS=30

# First run without demo sales (1 = with demo, 0 = sample menu only)
SEED_DEMO=1
# Demo restaurant data is regenerated after this many days
DEMO_REFRESH_DAYS=7

# Only for docker compose --profile tunnel (from Cloudflare Zero Trust → Tunnels)
# CLOUDFLARE_TUNNEL_TOKEN=
